{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --tsconfig jsconfig.json --deny-warnings src",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "test:integration": "node scripts/verify-ui.mjs",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "oxlint": "1.88.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3"
  }
}
