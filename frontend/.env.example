# Server-only Django URL. Browser requests use Next.js API routes.
API_URL=http://127.0.0.1:8000/api/
# NEXT_PUBLIC_API_URL is still accepted for compatibility with existing environments.
# Public values below are embedded into the browser bundle at build time.
NEXT_PUBLIC_DEMO_MODE=false
# Only intentional public demonstration credentials belong here; never API keys.
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=
