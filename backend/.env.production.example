DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DJANGO_ALLOWED_HOSTS=your-api.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_CONN_MAX_AGE=0
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=replace-privately
CLOUDINARY_API_SECRET=replace-privately
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.outlook.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-privately
EMAIL_HOST_PASSWORD=replace-privately
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=replace-privately
ADMIN_EMAIL=replace-privately
