DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
MEDIA_STORAGE=local
# Empty uses existing db.sqlite3. PostgreSQL is optional in development.
DATABASE_URL=
DB_CONN_MAX_AGE=0
# Public cloud name is only needed locally when displaying legacy cloud images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ADMIN_EMAIL=admin@localhost
# For real password-reset emails, use SMTP and supply these privately.
EMAIL_HOST=smtp.outlook.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=demo@localhost
